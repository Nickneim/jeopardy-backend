# Settings for compose.yaml on the instance. Nothing secret goes here.

# The backend image to run: a tag in the jeopardy-backend ECR repository
# (the git commit it was built from).
BACKEND_TAG=9a4dd64

# Browser origins allowed to call the API and open /ws. Becomes the
# CloudFront address once the distribution exists.
ALLOWED_ORIGINS=https://d14x3ygmehrd5x.cloudfront.net
