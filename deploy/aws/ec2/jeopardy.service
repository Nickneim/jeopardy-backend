[Unit]
Description=Jeopardy backend and Postgres (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/jeopardy/start.sh
ExecStop=/usr/bin/docker compose --project-directory /opt/jeopardy --env-file /opt/jeopardy/app.env down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
