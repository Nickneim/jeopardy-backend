{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheJeopardyDistributionReadsTheFrontend",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jeopardy-frontend-241200392621/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::241200392621:distribution/__DISTRIBUTION_ID__"
        }
      }
    }
  ]
}
