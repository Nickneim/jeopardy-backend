# Copy to .env (git-ignored) and fill in the password. The app, the tests,
# scripts/test.sh, scripts/data/psql.sh and Docker Compose all read it.
# compose.yaml creates the container's Postgres user with these credentials,
# so the test database (created in the same container) uses them too.
DATABASE_URL=jdbc:postgresql://localhost:5433/jeopardy
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
TEST_DATABASE_URL=jdbc:postgresql://localhost:5433/jeopardy_test
TEST_DATABASE_USERNAME=postgres
TEST_DATABASE_PASSWORD=change-me
