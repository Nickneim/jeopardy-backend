# Copy to .env (git-ignored) and fill in the password. The app,
# scripts/data/psql.sh and Docker Compose read it; compose.yaml creates the
# container's Postgres user with these credentials. The tests don't need it:
# they start their own database (TestcontainersConfiguration).
# 127.0.0.1 rather than localhost: compose.yaml publishes the port on IPv4
# only, and tools that try localhost's IPv6 address first (psql, psycopg)
# wait for that attempt to time out on every connection.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/jeopardy
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
